# bat configuration file
# For more info: bat --help or https://github.com/sharkdp/bat

# Use the terminal palette (Snazzy, see alacritty.toml). Run `bat --list-themes` for others.
--theme="ansi"

# Show line numbers, git status modifications, and file headers.
--style="numbers,changes,header"

# Enable italic text in the terminal.
--italic-text=always

# Use page navigation (less) for long outputs.
--pager="less --quit-if-one-screen --RAW-CONTROL-CHARS"
